{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@dcompass/auth": ["packages/auth/src"],
      "@dcompass/auth/*": ["packages/auth/src/*"],
      "@dcompass/config": ["packages/config/src"],
      "@dcompass/config/*": ["packages/config/src/*"],
      "@dcompass/db": ["packages/db/src"],
      "@dcompass/db/*": ["packages/db/src/*"],
      "@dcompass/domain": ["packages/domain/src"],
      "@dcompass/domain/*": ["packages/domain/src/*"],
      "@dcompass/ui": ["packages/ui/src"],
      "@dcompass/ui/*": ["packages/ui/src/*"],
      "@dcompass/validation": ["packages/validation/src"],
      "@dcompass/validation/*": ["packages/validation/src/*"]
    }
  }
}
