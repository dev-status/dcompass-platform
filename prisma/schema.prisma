generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  invited
  suspended
  disabled
}

enum UserRole {
  client
  partner
  admin
  scanner
}

enum RoleAssignmentStatus {
  active
  revoked
}

enum PartnerProfileStatus {
  pending
  active
  suspended
}

enum ContractStatus {
  draft
  shared_for_review
  approved_for_signing
  signed
  valid
  expired
  cancelled
}

enum CommissionType {
  percentage
  fixed
}

enum EventStatus {
  draft
  pending_review
  approved
  published
  sold_out
  cancelled
  archived
}

enum TicketTypeStatus {
  draft
  active
  sold_out
  hidden
  cancelled
}

enum OrderStatus {
  pending_payment
  paid
  failed
  cancelled
  refunded
}

enum PaymentProvider {
  mercado_pago
  manual
}

enum PaymentStatus {
  pending
  approved
  failed
  refunded
  cancelled
}

enum ReservationStatus {
  active
  expired
  converted
  cancelled
}

enum TicketSourceType {
  purchase
  courtesy
}

enum TicketStatus {
  issued
  pending_transfer
  transferred
  used
  cancelled
  refunded
  invalidated
}

enum TicketTransferStatus {
  pending
  accepted
  completed
  rejected
  cancelled
  expired
}

enum AccessScanStatus {
  success
  invalid
  already_used
  wrong_event
  expired_token
  ticket_cancelled
  scanner_not_authorized
}

enum PayoutType {
  advance
  final_settlement
}

enum PayoutStatus {
  draft
  approved
  scheduled
  paid
  failed
  reversed
}

enum AuditEntityType {
  user
  role_assignment
  invitation_code
  partner_profile
  partner_contract
  event
  ticket_type
  courtesy_grant
  order
  ticket_reservation
  ticket
  ticket_transfer
  scanner_assignment
  access_scan
  payout
}

model User {
  id                 String               @id @default(cuid())
  firebaseUid        String?              @unique @map("firebase_uid")
  email              String               @unique
  emailVerified      Boolean              @default(false) @map("email_verified")
  fullName           String               @map("full_name")
  phone              String?
  status             UserStatus           @default(active)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  roleAssignments    UserRoleAssignment[]
  partnerProfile     PartnerProfile?
  redeemedInvites    InvitationCode[]     @relation("RedeemedInvitationCodes")
  createdInvites     InvitationCode[]     @relation("CreatedInvitationCodes")
  orders             Order[]              @relation("BuyerOrders")
  ticketReservations TicketReservation[]
  ownedTickets       Ticket[]             @relation("TicketOwner")
  issuedTickets      Ticket[]             @relation("TicketIssuedTo")
  outgoingTransfers  TicketTransfer[]     @relation("TransferFromUser")
  incomingTransfers  TicketTransfer[]     @relation("TransferToUser")
  assignedContacts   UserContact[]        @relation("ContactOwner")
  contactOf          UserContact[]        @relation("ContactTarget")
  scannerAssignments ScannerAssignment[]  @relation("ScannerUserAssignments")
  grantedRoles       UserRoleAssignment[] @relation("RoleGrantedBy")
  audits             AuditLog[]           @relation("AuditActor")
  approvedPayouts    Payout[]             @relation("PayoutApprovedBy")
  scans              AccessScan[]         @relation("ScannerUserScans")
  eventReviews       EventReviewLog[]     @relation("EventReviewPerformedBy")
}

model UserRoleAssignment {
  id              String               @id @default(cuid())
  userId          String               @map("user_id")
  role            UserRole
  status          RoleAssignmentStatus @default(active)
  grantedByUserId String?              @map("granted_by_user_id")
  grantedAt       DateTime             @default(now()) @map("granted_at")
  revokedAt       DateTime?            @map("revoked_at")
  user            User                 @relation(fields: [userId], references: [id])
  grantedBy       User?                @relation("RoleGrantedBy", fields: [grantedByUserId], references: [id])

  @@index([userId])
  @@index([role, status])
  @@map("user_role_assignments")
}

model PartnerProfile {
  id                String              @id @default(cuid())
  userId            String              @unique @map("user_id")
  legalName         String              @map("legal_name")
  displayName       String?             @map("display_name")
  phone             String?
  taxId             String?             @map("tax_id")
  address           String?
  bankAccountInfo   String?             @map("bank_account_info")
  status            PartnerProfileStatus @default(pending)
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  user              User                @relation(fields: [userId], references: [id])
  contracts         PartnerContract[]
  events            Event[]
  payouts           Payout[]

  @@map("partner_profiles")
}

model InvitationCode {
  code             String    @id
  targetRole       UserRole  @map("target_role")
  status           String
  createdByUserId  String?   @map("created_by_user_id")
  redeemedByUserId String?   @map("redeemed_by_user_id")
  redeemedAt       DateTime? @map("redeemed_at")
  expiresAt        DateTime? @map("expires_at")
  metadata         Json?
  createdAt        DateTime  @default(now()) @map("created_at")
  createdBy        User?     @relation("CreatedInvitationCodes", fields: [createdByUserId], references: [id])
  redeemedBy       User?     @relation("RedeemedInvitationCodes", fields: [redeemedByUserId], references: [id])

  @@index([targetRole, status])
  @@map("invitation_codes")
}

model PartnerContract {
  id                       String         @id @default(cuid())
  partnerProfileId         String         @map("partner_profile_id")
  contractNumber           String         @unique @map("contract_number")
  status                   ContractStatus
  draftFileUrl             String?        @map("draft_file_url")
  signedFileUrl            String?        @map("signed_file_url")
  signedAt                 DateTime?      @map("signed_at")
  startsAt                 DateTime?      @map("starts_at")
  endsAt                   DateTime?      @map("ends_at")
  commissionType           CommissionType @map("commission_type")
  commissionValue          Decimal        @db.Decimal(10, 2) @map("commission_value")
  advanceEnabled           Boolean        @default(false) @map("advance_enabled")
  advancePercentage        Decimal?       @db.Decimal(5, 2) @map("advance_percentage")
  advanceDaysBeforeEvent   Int?           @map("advance_days_before_event")
  finalSettlementDelayDays Int?           @map("final_settlement_delay_days")
  notes                    String?
  createdAt                DateTime       @default(now()) @map("created_at")
  updatedAt                DateTime       @updatedAt @map("updated_at")
  partnerProfile           PartnerProfile @relation(fields: [partnerProfileId], references: [id])

  @@index([partnerProfileId, status])
  @@map("partner_contracts")
}

model Event {
  id               String           @id @default(cuid())
  partnerProfileId String           @map("partner_profile_id")
  status           EventStatus      @default(draft)
  title            String
  description      String?
  timezone         String
  startAt          DateTime         @map("start_at")
  endAt            DateTime?        @map("end_at")
  doorsOpenAt      DateTime?        @map("doors_open_at")
  venueName        String           @map("venue_name")
  addressLine      String?          @map("address_line")
  city             String?
  state            String?
  country          String?
  postalCode       String?          @map("postal_code")
  latitude         Decimal?         @db.Decimal(10, 7)
  longitude        Decimal?         @db.Decimal(10, 7)
  coverImageUrl    String?          @map("cover_image_url")
  gallery          Json?
  lineup           Json?
  restrictions     Json?
  accessPolicy     String?          @map("access_policy")
  contactEmail     String?          @map("contact_email")
  contactPhone     String?          @map("contact_phone")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  partnerProfile   PartnerProfile   @relation(fields: [partnerProfileId], references: [id])
  ticketTypes      TicketType[]
  courtesyGrants   CourtesyGrant[]
  reservations     TicketReservation[]
  tickets          Ticket[]
  scannerAssignments ScannerAssignment[]
  scans            AccessScan[]
  reviewLogs       EventReviewLog[]
  orders           Order[]
  payouts          Payout[]

  @@index([partnerProfileId, status])
  @@index([status, startAt])
  @@map("events")
}

model EventReviewLog {
  id                String      @id @default(cuid())
  eventId           String      @map("event_id")
  actionType        String      @map("action_type")
  performedByUserId String?     @map("performed_by_user_id")
  fromStatus        EventStatus? @map("from_status")
  toStatus          EventStatus? @map("to_status")
  notes             String?
  payloadSnapshot   Json?       @map("payload_snapshot")
  createdAt         DateTime    @default(now()) @map("created_at")
  event             Event       @relation(fields: [eventId], references: [id])
  performedBy       User?       @relation("EventReviewPerformedBy", fields: [performedByUserId], references: [id])

  @@index([eventId, createdAt])
  @@map("event_review_logs")
}

model TicketType {
  id                    String           @id @default(cuid())
  eventId               String           @map("event_id")
  name                  String
  description           String?
  category              String?
  priceAmount           Decimal          @db.Decimal(10, 2) @map("price_amount")
  currency              String
  stockTotal            Int              @default(0) @map("stock_total")
  stockReserved         Int              @default(0) @map("stock_reserved")
  stockSold             Int              @default(0) @map("stock_sold")
  stockTransferred      Int              @default(0) @map("stock_transferred")
  stockUsed             Int              @default(0) @map("stock_used")
  purchaseLimitPerOrder Int?             @map("purchase_limit_per_order")
  courtesyEnabled       Boolean          @default(false) @map("courtesy_enabled")
  status                TicketTypeStatus @default(draft)
  salesStartAt          DateTime?        @map("sales_start_at")
  salesEndAt            DateTime?        @map("sales_end_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  event                 Event            @relation(fields: [eventId], references: [id])
  orderItems            OrderItem[]
  tickets               Ticket[]
  reservations          TicketReservation[]
  courtesyGrants        CourtesyGrant[]

  @@index([eventId, status])
  @@map("ticket_types")
}

model CourtesyGrant {
  id                   String    @id @default(cuid())
  eventId              String    @map("event_id")
  ticketTypeId         String    @map("ticket_type_id")
  issuedByUserId       String?   @map("issued_by_user_id")
  assignedToUserId     String?   @map("assigned_to_user_id")
  status               String
  commissionBaseAmount Decimal?  @db.Decimal(10, 2) @map("commission_base_amount")
  notes                String?
  createdAt            DateTime  @default(now()) @map("created_at")
  assignedAt           DateTime? @map("assigned_at")
  event                Event     @relation(fields: [eventId], references: [id])
  ticketType           TicketType @relation(fields: [ticketTypeId], references: [id])

  @@index([eventId, status])
  @@map("courtesy_grants")
}

model Order {
  id               String          @id @default(cuid())
  buyerUserId      String          @map("buyer_user_id")
  eventId          String          @map("event_id")
  status           OrderStatus
  currency         String
  subtotalAmount   Decimal         @db.Decimal(10, 2) @map("subtotal_amount")
  totalAmount      Decimal         @db.Decimal(10, 2) @map("total_amount")
  paymentProvider  PaymentProvider @map("payment_provider")
  paymentReference String?         @map("payment_reference")
  paymentStatus    PaymentStatus   @default(pending) @map("payment_status")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  buyer            User            @relation("BuyerOrders", fields: [buyerUserId], references: [id])
  event            Event           @relation(fields: [eventId], references: [id])
  items            OrderItem[]
  tickets          Ticket[]
  reservations     TicketReservation[]

  @@index([buyerUserId, createdAt])
  @@index([eventId, status])
  @@map("orders")
}

model OrderItem {
  id              String    @id @default(cuid())
  orderId         String    @map("order_id")
  ticketTypeId    String    @map("ticket_type_id")
  quantity        Int
  unitPriceAmount Decimal   @db.Decimal(10, 2) @map("unit_price_amount")
  lineTotalAmount Decimal   @db.Decimal(10, 2) @map("line_total_amount")
  order           Order     @relation(fields: [orderId], references: [id])
  ticketType      TicketType @relation(fields: [ticketTypeId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model TicketReservation {
  id                 String            @id @default(cuid())
  eventId            String            @map("event_id")
  ticketTypeId       String            @map("ticket_type_id")
  buyerUserId        String            @map("buyer_user_id")
  quantity           Int
  status             ReservationStatus
  expiresAt          DateTime          @map("expires_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  releasedAt         DateTime?         @map("released_at")
  convertedToOrderId String?           @map("converted_to_order_id")
  event              Event             @relation(fields: [eventId], references: [id])
  ticketType         TicketType        @relation(fields: [ticketTypeId], references: [id])
  buyer              User              @relation(fields: [buyerUserId], references: [id])
  convertedToOrder   Order?            @relation(fields: [convertedToOrderId], references: [id])

  @@index([buyerUserId, status])
  @@index([eventId, ticketTypeId, status])
  @@map("ticket_reservations")
}

model Ticket {
  id               String          @id @default(cuid())
  eventId          String          @map("event_id")
  ticketTypeId     String          @map("ticket_type_id")
  orderId          String?         @map("order_id")
  ownerUserId      String          @map("owner_user_id")
  issuedToUserId   String?         @map("issued_to_user_id")
  sourceType       TicketSourceType @map("source_type")
  status           TicketStatus    @default(issued)
  serialCode       String          @unique @map("serial_code")
  dynamicQrSeedRef String?         @map("dynamic_qr_seed_ref")
  issuedAt         DateTime        @default(now()) @map("issued_at")
  usedAt           DateTime?       @map("used_at")
  cancelledAt      DateTime?       @map("cancelled_at")
  refundedAt       DateTime?       @map("refunded_at")
  event            Event           @relation(fields: [eventId], references: [id])
  ticketType       TicketType      @relation(fields: [ticketTypeId], references: [id])
  order            Order?          @relation(fields: [orderId], references: [id])
  owner            User            @relation("TicketOwner", fields: [ownerUserId], references: [id])
  issuedTo         User?           @relation("TicketIssuedTo", fields: [issuedToUserId], references: [id])
  transfers        TicketTransfer[]
  scans            AccessScan[]

  @@index([eventId, status])
  @@index([ownerUserId, status])
  @@map("tickets")
}

model TicketTransfer {
  id                String               @id @default(cuid())
  ticketId          String               @map("ticket_id")
  fromUserId        String               @map("from_user_id")
  toUserId          String               @map("to_user_id")
  status            TicketTransferStatus
  createdAt         DateTime             @default(now()) @map("created_at")
  acceptedAt        DateTime?            @map("accepted_at")
  completedAt       DateTime?            @map("completed_at")
  cancelledAt       DateTime?            @map("cancelled_at")
  expiredAt         DateTime?            @map("expired_at")
  expiresAt         DateTime?            @map("expires_at")
  cancelledByUserId String?              @map("cancelled_by_user_id")
  rejectionReason   String?              @map("rejection_reason")
  ticket            Ticket               @relation(fields: [ticketId], references: [id])
  fromUser          User                 @relation("TransferFromUser", fields: [fromUserId], references: [id])
  toUser            User                 @relation("TransferToUser", fields: [toUserId], references: [id])

  @@index([ticketId, status])
  @@index([toUserId, status])
  @@map("ticket_transfers")
}

model UserContact {
  id            String   @id @default(cuid())
  ownerUserId   String   @map("owner_user_id")
  contactUserId String   @map("contact_user_id")
  nickname      String?
  createdAt     DateTime @default(now()) @map("created_at")
  owner         User     @relation("ContactOwner", fields: [ownerUserId], references: [id])
  contact       User     @relation("ContactTarget", fields: [contactUserId], references: [id])

  @@unique([ownerUserId, contactUserId])
  @@map("user_contacts")
}

model ScannerAssignment {
  id               String   @id @default(cuid())
  scannerUserId    String   @map("scanner_user_id")
  eventId          String   @map("event_id")
  status           String
  assignedByUserId String?  @map("assigned_by_user_id")
  assignedAt       DateTime @default(now()) @map("assigned_at")
  revokedAt        DateTime? @map("revoked_at")
  scannerUser      User     @relation("ScannerUserAssignments", fields: [scannerUserId], references: [id])
  event            Event    @relation(fields: [eventId], references: [id])

  @@index([scannerUserId, status])
  @@index([eventId, status])
  @@map("scanner_assignments")
}

model AccessScan {
  id            String           @id @default(cuid())
  eventId       String           @map("event_id")
  ticketId      String?          @map("ticket_id")
  scannerUserId String?          @map("scanner_user_id")
  scanStatus    AccessScanStatus @map("scan_status")
  reasonCode    String?          @map("reason_code")
  scannedAt     DateTime         @default(now()) @map("scanned_at")
  deviceId      String?          @map("device_id")
  metadata      Json?
  event         Event            @relation(fields: [eventId], references: [id])
  ticket        Ticket?          @relation(fields: [ticketId], references: [id])
  scannerUser   User?            @relation("ScannerUserScans", fields: [scannerUserId], references: [id])

  @@index([eventId, scannedAt])
  @@index([ticketId, scanStatus])
  @@map("access_scans")
}

model Payout {
  id                     String       @id @default(cuid())
  partnerProfileId       String       @map("partner_profile_id")
  eventId                String?      @map("event_id")
  payoutType             PayoutType   @map("payout_type")
  status                 PayoutStatus
  grossSalesAmount       Decimal      @db.Decimal(12, 2) @map("gross_sales_amount")
  processorFeeAmount     Decimal      @db.Decimal(12, 2) @map("processor_fee_amount")
  dcompassFeeAmount      Decimal      @db.Decimal(12, 2) @map("dcompass_fee_amount")
  courtesyCommissionAmount Decimal    @db.Decimal(12, 2) @map("courtesy_commission_amount")
  netEligibleAmount      Decimal      @db.Decimal(12, 2) @map("net_eligible_amount")
  payoutAmount           Decimal      @db.Decimal(12, 2) @map("payout_amount")
  scheduledFor           DateTime?    @map("scheduled_for")
  paidAt                 DateTime?    @map("paid_at")
  approvedByUserId       String?      @map("approved_by_user_id")
  notes                  String?
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")
  partnerProfile         PartnerProfile @relation(fields: [partnerProfileId], references: [id])
  event                  Event?       @relation(fields: [eventId], references: [id])
  approvedBy             User?        @relation("PayoutApprovedBy", fields: [approvedByUserId], references: [id])

  @@index([partnerProfileId, status])
  @@map("payouts")
}

model AuditLog {
  id          String          @id @default(cuid())
  actorUserId String?         @map("actor_user_id")
  entityType  AuditEntityType @map("entity_type")
  entityId    String          @map("entity_id")
  actionType  String          @map("action_type")
  oldValues   Json?           @map("old_values")
  newValues   Json?           @map("new_values")
  context     Json?
  createdAt   DateTime        @default(now()) @map("created_at")
  actor       User?           @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}
